#!/usr/bin/env bash
#
# pre-commit — advisory checks that shouldn't block a commit on their own.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Only bother if a staged file is actually a .go file.
if ! git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=ACM | grep -q '\.go$'; then
    exit 0
fi

echo "Running slopless-go checks..."
if ! output="$(cd "$REPO_ROOT" && make selfcheck 2>&1)"; then
    echo ""
    echo "Found some candidates worth a look. Every check here is advisory"
    echo "— not blocking this commit:"
    echo ""
    echo "$output"
    echo ""
fi

exit 0
